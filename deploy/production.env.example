# Template only: create a private environment file outside the public assets.
APP_ENV=production
PUBLIC_ORIGIN=https://exam.example.com
LISTEN_ADDR=127.0.0.1:8092
RUNNER_MODE=docker
RUNNER_TIMEOUT_SECONDS=30
RUNNER_MEMORY=512m
RUNNER_PIDS_LIMIT=128
RUNNER_CPUS=1
# Fill both values; production refuses empty or weak credentials.
ACCESS_USERNAME=
ACCESS_PASSWORD=
# Configure a dedicated rootless Docker context before launching the runner.
