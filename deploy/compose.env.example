# Copy to a private file OUTSIDE the repository. Do not commit credentials.
# Linux only. Compose infrastructure daemon and rootless correction daemon differ.
EXAM_DOMAIN=exam.example.com
ACCESS_USERNAME=testeurs
ACCESS_PASSWORD=
RUNNER_UID=1001
RUNNER_GID=1001
RUNNER_DOCKER_SOCKET=/run/user/1001/docker.sock
# Existing directory owned by the correction daemon's user, mode 0700.
# Must be absolute, outside /tmp, /app and /run, without ':' or ','.
RUNNER_WORK_DIR=/var/lib/z01-corrections
APP_PORT=8095
CATALOG_MODE=offline
RUNNER_TIMEOUT_SECONDS=30
RUNNER_MEMORY=512m
RUNNER_CPUS=1
RUNNER_PIDS_LIMIT=128
BUILD_SHA=local
